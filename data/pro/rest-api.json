        },
        "fc_api_invalid_state": {
            "message": "State or county is invalid.",
            "status": 400
        },
        "fc_api_invalid_country": {
            "message": "Country is invalid or has no address fields.",
            "status": 400
        },
        "fc_api_invalid_request": {
            "message": "The request could not be processed.",
            "status": 400
        },
        "fc_api_address_not_found": {
            "message": "Address entry was not found.",
            "status": 404
        },
        "fc_api_address_create_failed": {
            "message": "Could not create address entry.",
