    "resources": [
        {
            "id": "address-book",
            "title": "Address Book",
            "description": "REST API endpoint: Address Book (`fluid-checkout/v1/address-book`). Routes intentionally ignore FC_AddressBook_AddressBook::is_feature_enabled(). The API stays available when the storefront feature is disabled so address book data can be prepared first. POST `/address-book` creates an entry via FC_AddressBook_AddressBook::add_new_address_book_entry(). Any `address_id` in the body is ignored; the feature class always assigns a new id. POST `/address-book/{address_id}` replaces the stored entry with the request body. Clients must send the full address entry (same fields as create), not a partial patch.",
            "source": {
                "class": "FC_AddressBook_REST_API_V1_Endpoint_AddressBook",
                "file": "inc/rest-api/v1/class-v1-endpoint-address-book.php"
            },
            "errorIds": [
                "fc_api_forbidden",
                "fc_api_user_not_found",
                "fc_api_unavailable",
                "fc_api_required_field_missing",
                "fc_api_invalid_postcode",
                "fc_api_invalid_phone",
                "fc_api_invalid_state",
                "fc_api_invalid_country",
                "fc_api_invalid_request",
                "fc_api_address_not_found",
                "fc_api_address_create_failed",
                "fc_api_address_update_failed",
                "fc_api_address_delete_failed",
                "fc_api_address_duplicate",
                "fc_api_address_id_missing"
            ],
            "routes": [
                {
                    "methods": "GET",
                    "path": "/address-book",
                    "handler": "get_address_entries",
                    "args": {
                        "user_id": {
                            "type": "integer",
                            "required": false,
                            "description": "WordPress user ID whose address book is targeted. Defaults to the current user."
                        }
                    }
                },
                {
                    "methods": "GET",
                    "path": "/address-book/{address_id}",
                    "handler": "get_address_entry_single",
                    "args": {
                        "user_id": {
                            "type": "integer",
                            "required": false,
                            "description": "WordPress user ID whose address book is targeted. Defaults to the current user."
                        },
                        "address_id": {
                            "type": "integer",
                            "required": true,
                            "description": "Address book entry ID."
                        }
                    }
                },
                {
                    "methods": "POST",
                    "path": "/address-book",
                    "handler": "create_address_entry",
                    "args": {
                        "user_id": {
                            "type": "integer",
                            "required": false,
                            "description": "WordPress user ID whose address book is targeted. Defaults to the current user."
                        },
                        "first_name": {
                            "type": "string",
                            "required": false,
                            "description": "First name."
                        },
                        "last_name": {
                            "type": "string",
                            "required": false,
                            "description": "Last name."
                        },
                        "company": {
                            "type": "string",
                            "required": false,
                            "description": "Company."
                        },
                        "country": {
                            "type": "string",
                            "required": false,
                            "description": "Country code."
                        },
                        "address_1": {
                            "type": "string",
                            "required": false,
                            "description": "Address line 1."
                        },
                        "address_2": {
                            "type": "string",
                            "required": false,
                            "description": "Address line 2."
                        },
                        "city": {
                            "type": "string",
                            "required": false,
                            "description": "City."
                        },
                        "state": {
                            "type": "string",
                            "required": false,
                            "description": "State or county."
                        },
                        "postcode": {
                            "type": "string",
                            "required": false,
                            "description": "Postcode or ZIP."
                        },
                        "address_label": {
                            "type": "string",
                            "required": false,
                            "description": "Address label."
                        },
                        "phone": {
                            "type": "string",
                            "required": false,
                            "description": "Phone number."
                        },
                        "default_shipping": {
                            "type": "boolean",
                            "required": false,
                            "description": "Whether this entry is the default shipping address."
                        },
                        "default_billing": {
                            "type": "boolean",
                            "required": false,
                            "description": "Whether this entry is the default billing address."
                        }
                    },
                    "notes": "Creates a new entry. Any address_id in the body is ignored; the feature class assigns a new id."
                },
                {
                    "methods": "POST",
                    "path": "/address-book/{address_id}",
                    "handler": "update_address_entry",
                    "args": {
                        "user_id": {
                            "type": "integer",
                            "required": false,
                            "description": "WordPress user ID whose address book is targeted. Defaults to the current user."
                        },
                        "address_id": {
                            "type": "integer",
                            "required": true,
                            "description": "Address book entry ID."
                        },
