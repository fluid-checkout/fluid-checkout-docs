{
    "namespace": "fluid-checkout/v1",
    "baseUrl": "{site}/wp-json/fluid-checkout/v1",
    "permissions": "Requests require a logged-in WordPress user. Omit user_id to use the current user's data, or pass user_id to target another account when the caller can edit that user (edit_user capability). Unauthenticated requests return fc_api_forbidden. An invalid user_id returns fc_api_user_not_found.",
    "responseShape": {
        "successWithData": "HTTP 200 with { \"data\": { ... } } when the handler returns a payload.",
        "successWithoutData": "HTTP 200 with { \"success\": true } when there is no payload (for example DELETE).",
        "errors": "Failures return WordPress REST error JSON from WP_Error (code, message, data.status). Wire codes use the fc_api_* prefix."
    },
    "errors": {
        "fc_api_forbidden": {
            "message": "Forbidden access.",
            "status": 403
        },
        "fc_api_user_not_found": {
            "message": "Target user was not found.",
            "status": 404
        },
