                            "description": "Country code."
                        },
                        "address_1": {
                            "type": "string",
                            "required": false,
                            "description": "Address line 1."
                        },
                        "address_2": {
                            "type": "string",
                            "required": false,
                            "description": "Address line 2."
                        },
                        "city": {
                            "type": "string",
                            "required": false,
                            "description": "City."
                        },
                        "state": {
                            "type": "string",
                            "required": false,
                            "description": "State or county."
                        },
                        "postcode": {
                            "type": "string",
                            "required": false,
                            "description": "Postcode or ZIP."
                        },
                        "address_label": {
                            "type": "string",
                            "required": false,
                            "description": "Address label."
                        },
                        "phone": {
                            "type": "string",
                            "required": false,
                            "description": "Phone number."
                        },
                        "default_shipping": {
                            "type": "boolean",
                            "required": false,
                            "description": "Whether this entry is the default shipping address."
                        },
                        "default_billing": {
                            "type": "boolean",
                            "required": false,
                            "description": "Whether this entry is the default billing address."
                        }
                    },
                    "notes": "Full replace: send the complete address entry in the request body. Omitted fields are not merged from storage."
                },
                {
                    "methods": "DELETE",
                    "path": "/address-book/{address_id}",
                    "handler": "delete_address_entry",
                    "args": {
                        "user_id": {
                            "type": "integer",
                            "required": false,
                            "description": "WordPress user ID whose address book is targeted. Defaults to the current user."
                        },
